# ========== LLM API 密钥 与 Provider ==========
# DeepSeek API 密钥（仅开发初期临时使用）
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
# Qwen API 密钥（正式部署推荐）
QWEN_API_KEY=your_qwen_api_key_here
# OpenAI API 密钥
OPENAI_API_KEY=sk-your-openai-key-here
# LLM 提供商选择：deepseek / qwen / openai（默认 deepseek）
LLM_PROVIDER=deepseek

# ========== LLM API 地址与模型（可选覆盖默认值） ==========
# DEEPSEEK_API_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL_NAME=deepseek-chat
# QWEN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL_NAME=qwen-plus
# OPENAI_API_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL_NAME=gpt-4o

# ========== 日志配置 ==========
# 日志级别：DEBUG / INFO / WARNING / ERROR（默认 INFO）
LOG_LEVEL=INFO
# 日志文件路径（默认 data/logs/system.log）
LOG_FILE=data/logs/system.log

# ========== 路径配置 ==========
# 知识库根目录（默认 knowledge_base）
KB_DIR=knowledge_base
# 算法画像文件路径
# ALGORITHM_PROFILE_PATH=knowledge_base/algorithm_profile.json
# 历史实验结果文件路径
# HISTORICAL_RESULTS_PATH=knowledge_base/historical_results.json
# 数据根目录（默认 data）
DATA_DIR=data
# 本地大资产根目录（默认仓库根目录的 assets；可改为外部磁盘路径）
# ASSETS_DIR=D:/PathPlanningAssets
# 地图数据目录（默认 $ASSETS_DIR/maps）
# MAPS_DIR=D:/PathPlanningAssets/maps
# 实验数据目录
# EXPERIMENTS_DIR=data/experiments
# 日志目录
# LOGS_DIR=data/logs
# 报告输出目录
# REPORTS_DIR=reports/generated_reports
# 实验数据库路径（默认 data/experiments/experiments.sqlite）
EXPERIMENT_DB_PATH=data/experiments/experiments.sqlite

# ========== 环境分级阈值 ==========
# 低障碍率上限，0-1（默认 0.20）
OBSTACLE_LOW_THRESHOLD=0.20
# 中障碍率上限，0-1（默认 0.50）
OBSTACLE_MEDIUM_THRESHOLD=0.50

# ========== 规则惩罚参数 ==========
# 算力受限时触发耗时惩罚的阈值，单位秒（默认 1.5）
# PENALTY_HIGH_TIME_THRESHOLD=1.5
# 耗时超阈值的扣分幅度，0-1（默认 0.15）
# PENALTY_HIGH_TIME_VALUE=0.15
# 高复杂度下触发低成功率惩罚的阈值，0-1（默认 0.80）
# PENALTY_LOW_SUCCESS_RATE=0.80
# 成功率过低时的扣分幅度，0-1（默认 0.20）
# PENALTY_LOW_SUCCESS_VALUE=0.20
# 低复杂度下过度配置扣分，0-1（默认 0.10）
# PENALTY_OVERKILL_VALUE=0.10
# 差连通性下最低成功率阈值，0-1（默认 0.85）
# PENALTY_POOR_CONNECTIVITY_SUCCESS=0.85
# 差连通性场景扣分幅度，0-1（默认 0.15）
# PENALTY_POOR_CONNECTIVITY_VALUE=0.15
# 连通性差判定阈值，0-1（默认 0.4）
POOR_CONNECTIVITY_THRESHOLD=0.4

# ========== 人在回路参数 ==========
# 前两名评分差距阈值，低于此值触发人工校验（默认 0.05）
SCORE_GAP_THRESHOLD=0.05

# ========== 评分权重（JSON 格式，可选覆盖） ==========
# 完整权重示例（以下为默认值，可取消注释自定义）：
# WEIGHTS_JSON={"低复杂度":{"time":0.25,"path_length":0.20,"success_rate":0.15,"stability":0.08,"smoothness":0.08,"safety_score":0.08,"expanded_nodes":0.05,"compute_cost":0.05,"robustness":0.06},"中复杂度":{"time":0.18,"path_length":0.20,"success_rate":0.20,"stability":0.08,"smoothness":0.06,"safety_score":0.08,"expanded_nodes":0.05,"compute_cost":0.05,"robustness":0.10},"高复杂度":{"time":0.10,"path_length":0.12,"success_rate":0.30,"stability":0.10,"smoothness":0.05,"safety_score":0.08,"expanded_nodes":0.05,"compute_cost":0.05,"robustness":0.15}}

# ========== 地图默认参数 ==========
# 默认地图宽度（默认 100）
DEFAULT_MAP_WIDTH=100
# 默认地图高度（默认 100）
DEFAULT_MAP_HEIGHT=100
